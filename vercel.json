{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|images/|icons/|\.well-known/|manifest\\.json|sw\\.js|logo\\.svg|privacy-policy\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/stripe-webhook.js": {
      "maxDuration": 30
    }
  }
}
