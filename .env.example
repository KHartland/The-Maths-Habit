# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration (for client-side)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Stripe Price IDs (create these in your Stripe Dashboard)
# Products > Create product > Add pricing
VITE_STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
VITE_STRIPE_PRICE_YEARLY=price_your_yearly_price_id

# Server-side Stripe Configuration (set in Vercel Environment Variables)
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Supabase Service Role Key (for server-side, set in Vercel)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend URL (set in Vercel)
# FRONTEND_URL=https://the-maths-habit-clrx.vercel.app

# Mathpix API (for handwriting recognition)
# Get keys from https://accounts.mathpix.com/
VITE_MATHPIX_APP_ID=your_mathpix_app_id
VITE_MATHPIX_APP_KEY=your_mathpix_app_key

# Sentry Error Tracking
# Create a free account at https://sentry.io
# Create a JavaScript Browser project and copy the DSN
VITE_SENTRY_DSN=your_sentry_dsn

# RevenueCat (native in-app purchases)
# Create a free account at https://www.revenuecat.com
# Use platform-specific API keys from your RevenueCat project
VITE_REVENUECAT_IOS_KEY=appl_your_ios_key
VITE_REVENUECAT_ANDROID_KEY=goog_your_android_key
